{
    "version": "0.1.0",
    "ui": {
        "theme": "dark",
        "language": "fr",
        "window": {
            "width": 1280,
            "height": 800,
            "maximized": false
        },
        "grid": {
            "columns": 4,
            "spacing": 16,
            "card_ratio": "3:4"
        }
    },
    "images": {
        "storage_path": "data/images",
        "max_width": 1920,
        "formats": ["jpg", "jpeg", "png"],
        "compression": {
            "enabled": true,
            "quality": 85
        }
    },
    "session": {
        "auto_save": true,
        "save_path": "data/sessions",
        "default_duration": 300,
        "intervals": [30, 60, 120, 300]
    },
    "database": {
        "type": "json",
        "path": "data/db.json"
    }
} 