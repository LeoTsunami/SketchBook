QMainWindow {
    background-color: #0d111a;
    color: #eaf6ff;
    font-family: "Kalam";
}
QWidget#TabBarRow {
    background-color: rgba(17, 24, 49, 0.7);
}
QPushButton#TabButton {
    background-color: transparent;
    color: rgba(234, 246, 255, 0.55);
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
    padding: 4px 14px;
    font-size: 11px;
    font-weight: bold;
}
QPushButton#TabButton:hover {
    color: #eaf6ff;
    background-color: rgba(255, 255, 255, 0.06);
}
QPushButton#TabButton:checked {
    color: #eaf6ff;
    border-bottom: 2px solid #2a62ff;
}
QWidget#content {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0b1020, stop:1 #151a2f);
}
QMenuBar, QStatusBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #111831, stop:1 #1c2552);
    color: #eaf6ff;
}
QMenuBar::item:selected, QMenu::item:selected {
    background-color: #2a62ff;
    color: #ffffff;
}
QMenu {
    background-color: #141b33;
    color: #eaf6ff;
}
QLineEdit {
    background-color: #1a2242;
    color: #eaf6ff;
    border: 1px solid #3d4f8f;
    border-radius: 6px;
    padding: 4px;
}
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1d2a5c, stop:1 #243776);
    color: #eaf6ff;
    border: 1px solid #3d4f8f;
    border-radius: 6px;
    padding: 4px 8px;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #2441a5, stop:1 #2d56d1);
}
QScrollArea {
    background-color: #10162b;
    border: none;
}
QFrame#ImageThumbnail {
    background-color: transparent;
    border-radius: 6px;
    border: 1px solid rgba(126, 156, 255, 0.34);
}
QFrame#ImageThumbnail:hover {
    background-color: transparent;
    border: 1px solid rgba(174, 201, 255, 0.55);
}
QFrame#ImageThumbnail[selected="true"] {
    background-color: transparent;
    border: 2px solid #8eb5ff;
}
QFrame#ImageThumbnailSelection {
    background-color: rgba(142, 181, 255, 0.12);
    border: 3px solid #8eb5ff;
    border-radius: 5px;
}
QFrame#TagDropZone {
    background-color: #121a34;
    border: 2px dashed #3d4f8f;
    border-radius: 8px;
    color: #eaf6ff;
}
QTabWidget::pane {
    border: none;
    background-color: #10162b;
}
QTabBar::tab {
    background-color: #1a2242;
    color: #eaf6ff;
    border: 1px solid #31427c;
    border-bottom: none;
    padding: 8px 20px;
}
QTabBar::tab:selected {
    background-color: #2a62ff;
    border: 1px solid #8eb5ff;
    border-bottom: none;
}
