QMainWindow {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #171220,
        stop: 0.45 #26203a,
        stop: 1 #3c2442
    );
    color: #ffffff;
    font-family: "Segoe UI";
}
QLabel#welcome_text {
    color: #ffffff;
}
QMenuBar {
    background-color: rgba(10, 12, 20, 0.9);
    color: #ffffff;
}
QMenuBar::item:selected {
    background-color: #4b6eaf;
}
QMenu {
    background-color: #191d2d;
    color: #ffffff;
    min-width: 200px;
}
QMenu::item:selected {
    background-color: #4b6eaf;
}
QStatusBar {
    background-color: rgba(10, 12, 20, 0.9);
    color: #ffffff;
}
QLineEdit {
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 4px;
    padding: 4px;
}
QLineEdit:focus {
    border: 1px solid rgba(255, 255, 255, 0.42);
}
QPushButton {
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 8px;
    padding: 4px 8px;
}
QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.16);
}
QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.24);
}
QPushButton#TagGridButton[tagActive="true"] {
    background-color: #4b6eaf;
    border: 1px solid #5d7bc0;
}
QPushButton#TagGridButton[tagActive="true"]:hover {
    background-color: #5d7bc0;
}
QPushButton#TagGridButton[tagChildRow="true"] {
    background-color: rgba(75, 110, 175, 0.35);
    border: 1px solid rgba(93, 123, 192, 0.5);
}
QPushButton#TagGridButton[tagChildRow="true"]:hover {
    background-color: rgba(75, 110, 175, 0.5);
}
QPushButton#TagGridButton[tagActive="true"][tagChildRow="true"] {
    background-color: #4b6eaf;
    border: 1px solid #5d7bc0;
}
QPushButton#TagGridButton[tagActive="true"][tagChildRow="true"]:hover {
    background-color: #5d7bc0;
}
QScrollArea {
    background-color: transparent;
    border: none;
}
QScrollBar:vertical {
    background-color: #2d2d2d;
    width: 12px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background-color: #4d4d4d;
    min-height: 20px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
    background-color: #5d5d5d;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background-color: #2d2d2d;
}
QWidget#TabBarRow {
    background-color: rgba(10, 12, 20, 0.7);
}
QPushButton#TabButton {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.6);
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
    padding: 4px 14px;
    font-size: 11px;
    font-weight: bold;
}
QPushButton#TabButton:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.06);
}
QPushButton#TabButton:checked {
    color: #ffffff;
    border-bottom: 2px solid #6b9bd1;
}
QWidget#content {
    background-color: transparent;
}
QFrame#ImageThumbnail {
    background-color: transparent;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.12);
}
QFrame#ImageThumbnail:hover {
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.24);
}
QFrame#ImageThumbnail[selected="true"] {
    background-color: transparent;
    border: 2px solid #8ab9ff;
}
QFrame#ImageThumbnail[selected="true"]:hover {
    background-color: transparent;
    border: 2px solid #a8c8ff;
}
QFrame#ImageThumbnailSelection {
    background-color: rgba(93, 157, 255, 0.12);
    border: 3px solid #8ab9ff;
    border-radius: 5px;
}
QFrame#ImageThumbnail[dragOver="true"] {
    background-color: #5d7bc0;
    border: 3px dashed #ffffff;
}

/* Tag library: drop target when dragging a tag (QPushButton = category row, QLabel = shelf header) */
QPushButton#TagGridButton[dragOver="true"],
QLabel#TagGridButton[dragOver="true"] {
    background-color: rgba(93, 123, 192, 0.55);
    border: 3px dashed #8ab5ff;
    border-radius: 6px;
}


/* Tag Components */
QFrame#DraggableTagChip {
    background-color: #3c3f41;
    border: 1px solid #4d4d4d;
    border-radius: 12px;
    color: #ffffff;
}
QFrame#DraggableTagChip:hover {
    background-color: #4c4f51;
    border: 1px solid #5d5d5d;
}
QFrame#DraggableTagChip QLabel {
    color: #ffffff;
    background-color: transparent;
}
QFrame#DraggableTagChip QPushButton {
    background-color: transparent;
    border: none;
    color: inherit;
    font-weight: bold;
    font-size: 12px;
    padding: 0px;
}
QFrame#DraggableTagChip QPushButton:hover {
    color: #ff4444;
    background-color: transparent;
}

/* Tag Chips in Thumbnails */
QFrame#TagChip {
    background-color: rgba(60, 63, 65, 0.8);
    border: 1px solid rgba(77, 77, 77, 0.8);
    border-radius: 12px;
    color: #ffffff;
    padding: 2px;
}
QFrame#TagChip:hover {
    background-color: rgba(76, 79, 81, 0.9);
    border: 1px solid rgba(93, 93, 93, 0.9);
}
QFrame#TagChip QLabel {
    color: #ffffff;
    background-color: transparent;
    font-size: 11px;
}
QFrame#TagChip QPushButton {
    background-color: transparent;
    border: none;
    color: #ffffff;
    font-weight: bold;
    font-size: 14px;
    padding: 0px;
}
QFrame#TagChip QPushButton:hover {
    color: #ff4444;
    background-color: transparent;
}

/* Tags Container in Thumbnails */
QWidget#TagsContainer {
    background-color: transparent;
}

QFrame#TagDropZone {
    background-color: rgba(0, 0, 0, 0.22);
    border: 2px dashed #4d4d4d;
    border-radius: 8px;
    color: #ffffff;
}
QFrame#TagDropZone:hover {
    border: 2px dashed #5d5d5d;
    background-color: rgba(0, 0, 0, 0.30);
}
QFrame#TagDropZone[dragOver="true"] {
    border: 2px solid #5d5d5d;
    background-color: rgba(0, 0, 0, 0.34);
}
QFrame#TagDropZone QScrollArea {
    background-color: transparent;
    border: none;
}
QFrame#TagDropZone QScrollBar:vertical {
    background-color: #3c3f41;
    width: 12px;
    border-radius: 6px;
}
QFrame#TagDropZone QScrollBar::handle:vertical {
    background-color: #5d5d5d;
    border-radius: 6px;
    min-height: 20px;
}
QFrame#TagDropZone QScrollBar::handle:vertical:hover {
    background-color: #6d6d6d;
}
QFrame#TagDropZone QLabel {
    color: #ffffff;
    font-weight: bold;
    font-size: 11px;
}

/* Tab Widget */
QTabWidget::pane {
    border: none;
    background-color: transparent;
}
QTabBar {
    alignment: center;
}
QTabBar::tab {
    background-color: #3c3f41;
    color: #ffffff;
    border: 1px solid #4d4d4d;
    border-bottom: none;
    padding: 8px 20px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #4b6eaf;
    border: 1px solid #5d7bc0;
    border-bottom: none;
}
QTabBar::tab:hover {
    background-color: #4c4f51;
} 