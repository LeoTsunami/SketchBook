QMainWindow {
    background-color: #2b2b2b;
    color: #ffffff;
    font-family: "Kalam";
}
QLabel#welcome_text {
    color: #ffffff;
}
QMenuBar {
    background-color: #3c3f41;
    color: #ffffff;
}
QMenuBar::item:selected {
    background-color: #4b6eaf;
}
QMenu {
    background-color: #3c3f41;
    color: #ffffff;
    min-width: 200px;
}
QMenu::item:selected {
    background-color: #4b6eaf;
}
QStatusBar {
    background-color: #3c3f41;
    color: #ffffff;
}
QLineEdit {
    background-color: #3c3f41;
    color: #ffffff;
    border: 1px solid #4d4d4d;
    border-radius: 4px;
    padding: 4px;
}
QLineEdit:focus {
    border: 1px solid #5d5d5d;
}
QPushButton {
    background-color: #3c3f41;
    color: #ffffff;
    border: 1px solid #4d4d4d;
    border-radius: 4px;
    padding: 4px 8px;
}
QPushButton:hover {
    background-color: #4b6eaf;
}
QPushButton:pressed {
    background-color: #3d5a8c;
}
QPushButton#TagGridButton[tagActive="true"] {
    background-color: #4b6eaf;
    border: 1px solid #5d7bc0;
}
QPushButton#TagGridButton[tagActive="true"]:hover {
    background-color: #5d7bc0;
}
QScrollArea {
    background-color: #1e1e1e;
    border: none;
}
QScrollBar:vertical {
    background-color: #2d2d2d;
    width: 12px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background-color: #4d4d4d;
    min-height: 20px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
    background-color: #5d5d5d;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background-color: #2d2d2d;
}
QWidget#content {
    background-color: #1e1e1e;
}
QFrame#ImageThumbnail {
    background-color: #2d2d2d;
    border-radius: 4px;
    border: 1px solid #3d3d3d;
}
QFrame#ImageThumbnail:hover {
    background-color: #353535;
    border: 1px solid #4d4d4d;
}
QFrame#ImageThumbnail[selected="true"] {
    background-color: #4b6eaf;
    border: 2px solid #5d7bc0;
}
QFrame#ImageThumbnail[selected="true"]:hover {
    background-color: #5d7bc0;
    border: 2px solid #6d8bd0;
}
QFrame#ImageThumbnail[dragOver="true"] {
    background-color: #5d7bc0;
    border: 3px dashed #ffffff;
}

/* Tag Components */
QFrame#DraggableTagChip {
    background-color: #3c3f41;
    border: 1px solid #4d4d4d;
    border-radius: 12px;
    color: #ffffff;
}
QFrame#DraggableTagChip:hover {
    background-color: #4c4f51;
    border: 1px solid #5d5d5d;
}
QFrame#DraggableTagChip QLabel {
    color: #ffffff;
    background-color: transparent;
}
QFrame#DraggableTagChip QPushButton {
    background-color: transparent;
    border: none;
    color: inherit;
    font-weight: bold;
    font-size: 12px;
    padding: 0px;
}
QFrame#DraggableTagChip QPushButton:hover {
    color: #ff4444;
    background-color: transparent;
}

/* Tag Chips in Thumbnails */
QFrame#TagChip {
    background-color: rgba(60, 63, 65, 0.8);
    border: 1px solid rgba(77, 77, 77, 0.8);
    border-radius: 12px;
    color: #ffffff;
    padding: 2px;
}
QFrame#TagChip:hover {
    background-color: rgba(76, 79, 81, 0.9);
    border: 1px solid rgba(93, 93, 93, 0.9);
}
QFrame#TagChip QLabel {
    color: #ffffff;
    background-color: transparent;
    font-size: 11px;
}
QFrame#TagChip QPushButton {
    background-color: transparent;
    border: none;
    color: #ffffff;
    font-weight: bold;
    font-size: 14px;
    padding: 0px;
}
QFrame#TagChip QPushButton:hover {
    color: #ff4444;
    background-color: transparent;
}

/* Tags Container in Thumbnails */
QWidget#TagsContainer {
    background-color: transparent;
}

QFrame#TagDropZone {
    background-color: #2b2b2b;
    border: 2px dashed #4d4d4d;
    border-radius: 8px;
    color: #ffffff;
}
QFrame#TagDropZone:hover {
    border: 2px dashed #5d5d5d;
    background-color: #2f2f2f;
}
QFrame#TagDropZone[dragOver="true"] {
    border: 2px solid #5d5d5d;
    background-color: #2f2f2f;
}
QFrame#TagDropZone QScrollArea {
    background-color: transparent;
    border: none;
}
QFrame#TagDropZone QScrollBar:vertical {
    background-color: #3c3f41;
    width: 12px;
    border-radius: 6px;
}
QFrame#TagDropZone QScrollBar::handle:vertical {
    background-color: #5d5d5d;
    border-radius: 6px;
    min-height: 20px;
}
QFrame#TagDropZone QScrollBar::handle:vertical:hover {
    background-color: #6d6d6d;
}
QFrame#TagDropZone QLabel {
    color: #ffffff;
    font-weight: bold;
    font-size: 11px;
}

/* Tab Widget */
QTabWidget::pane {
    border: none;
    background-color: #1e1e1e;
}
QTabBar {
    alignment: center;
}
QTabBar::tab {
    background-color: #3c3f41;
    color: #ffffff;
    border: 1px solid #4d4d4d;
    border-bottom: none;
    padding: 8px 20px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #4b6eaf;
    border: 1px solid #5d7bc0;
    border-bottom: none;
}
QTabBar::tab:hover {
    background-color: #4c4f51;
} 