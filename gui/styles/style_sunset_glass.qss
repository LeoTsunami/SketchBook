QMainWindow {
    background-color: #1b1620;
    color: #fff2ea;
    font-family: "Kalam";
}
QWidget#TabBarRow {
    background-color: rgba(59, 31, 59, 0.7);
}
QPushButton#TabButton {
    background-color: transparent;
    color: rgba(255, 242, 234, 0.55);
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
    padding: 4px 14px;
    font-size: 11px;
    font-weight: bold;
}
QPushButton#TabButton:hover {
    color: #fff2ea;
    background-color: rgba(255, 255, 255, 0.06);
}
QPushButton#TabButton:checked {
    color: #fff2ea;
    border-bottom: 2px solid #ff7a59;
}
QWidget#content {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #2c1830, stop:0.55 #45243d, stop:1 #6d2f43);
}
QMenuBar, QStatusBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3b1f3b, stop:1 #6a2c4c);
    color: #fff2ea;
}
QMenuBar::item:selected, QMenu::item:selected {
    background-color: #ff7a59;
    color: #ffffff;
}
QMenu {
    background-color: #3a2238;
    color: #fff2ea;
}
QLineEdit {
    background-color: rgba(255, 255, 255, 0.12);
    color: #fff2ea;
    border: 1px solid rgba(255, 200, 170, 0.5);
    border-radius: 6px;
    padding: 4px;
}
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #7d3656, stop:1 #ab4b5b);
    color: #fff5ef;
    border: 1px solid #d77b78;
    border-radius: 6px;
    padding: 4px 8px;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #a5435f, stop:1 #d95e5a);
}
QScrollArea {
    background-color: rgba(20, 12, 22, 0.4);
    border: none;
}
QFrame#ImageThumbnail {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    border: 1px solid rgba(255, 210, 190, 0.35);
}
QFrame#ImageThumbnail[selected="true"] {
    background-color: #ff7a59;
    border: 2px solid #ffd0ba;
}
QFrame#TagDropZone {
    background-color: rgba(255, 255, 255, 0.08);
    border: 2px dashed rgba(255, 210, 190, 0.5);
    border-radius: 8px;
    color: #fff2ea;
}
QTabWidget::pane {
    border: none;
    background-color: rgba(20, 12, 22, 0.45);
}
QTabBar::tab {
    background-color: rgba(255, 255, 255, 0.12);
    color: #fff2ea;
    border: 1px solid rgba(255, 210, 190, 0.35);
    border-bottom: none;
    padding: 8px 20px;
}
QTabBar::tab:selected {
    background-color: #ff7a59;
    border: 1px solid #ffd0ba;
    border-bottom: none;
}
