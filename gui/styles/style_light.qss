QMainWindow {
    background-color: #ffffff;
    color: #000000;
}
QMenuBar {
    background-color: #f0f0f0;
    color: #000000;
}
QMenuBar::item:selected {
    background-color: #0078d7;
    color: #ffffff;
}
QMenu {
    background-color: #ffffff;
    color: #000000;
}
QMenu::item:selected {
    background-color: #0078d7;
    color: #ffffff;
}
QStatusBar {
    background-color: #f0f0f0;
    color: #000000;
}
QLineEdit {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 4px;
}
QLineEdit:focus {
    border: 1px solid #0078d7;
}
QPushButton {
    background-color: #f0f0f0;
    color: #000000;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 4px 8px;
}
QPushButton:hover {
    background-color: #e5e5e5;
}
QPushButton:pressed {
    background-color: #d0d0d0;
}
QScrollArea {
    background-color: #ffffff;
    border: none;
}
QScrollBar:vertical {
    background-color: #f0f0f0;
    width: 12px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background-color: #cccccc;
    min-height: 20px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
    background-color: #bbbbbb;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background-color: #f0f0f0;
}
QWidget#content {
    background-color: #ffffff;
}
QFrame#ImageThumbnail {
    background-color: #f5f5f5;
    border-radius: 4px;
    border: 1px solid #e0e0e0;
}
QFrame#ImageThumbnail:hover {
    background-color: #e8e8e8;
    border: 1px solid #cccccc;
}
QFrame#ImageThumbnail[selected="true"] {
    background-color: #0078d7;
    border: 2px solid #106ebe;
}
QFrame#ImageThumbnail[selected="true"]:hover {
    background-color: #106ebe;
    border: 2px solid #1a5fb4;
}

/* Tag Components */
QFrame#DraggableTagChip {
    background-color: #e0e0e0;
    border: 1px solid #cccccc;
    border-radius: 12px;
    color: #000000;
}
QFrame#DraggableTagChip:hover {
    background-color: #d0d0d0;
    border: 1px solid #bbbbbb;
}
QFrame#DraggableTagChip QLabel {
    color: #000000;
    background-color: transparent;
}
QFrame#DraggableTagChip QPushButton {
    background-color: transparent;
    border: none;
    color: inherit;
    font-weight: bold;
    font-size: 12px;
    padding: 0px;
}
QFrame#DraggableTagChip QPushButton:hover {
    color: #ff4444;
    background-color: transparent;
}

QFrame#TagDropZone {
    background-color: #f8f8f8;
    border: 2px dashed #cccccc;
    border-radius: 8px;
    color: #000000;
}
QFrame#TagDropZone:hover {
    border: 2px dashed #bbbbbb;
    background-color: #f0f0f0;
}
QFrame#TagDropZone[dragOver="true"] {
    border: 2px solid #bbbbbb;
    background-color: #f0f0f0;
}
QFrame#TagDropZone QScrollArea {
    background-color: transparent;
    border: none;
}
QFrame#TagDropZone QScrollBar:vertical {
    background-color: #e0e0e0;
    width: 12px;
    border-radius: 6px;
}
QFrame#TagDropZone QScrollBar::handle:vertical {
    background-color: #cccccc;
    border-radius: 6px;
    min-height: 20px;
}
QFrame#TagDropZone QScrollBar::handle:vertical:hover {
    background-color: #bbbbbb;
}
QFrame#TagDropZone QLabel {
    color: #000000;
    font-weight: bold;
    font-size: 11px;
}

/* Tab Widget */
QTabWidget::pane {
    border: none;
    background-color: #ffffff;
}
QTabBar {
    alignment: center;
}
QTabBar::tab {
    background-color: #f0f0f0;
    color: #000000;
    border: 1px solid #cccccc;
    border-bottom: none;
    padding: 8px 20px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #0078d7;
    color: #ffffff;
    border: 1px solid #106ebe;
    border-bottom: none;
}
QTabBar::tab:hover {
    background-color: #e5e5e5;
} 